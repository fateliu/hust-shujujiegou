{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "C: build active file",
                      "problemMatcher":  [
                                             "$gcc"
                                         ],
                      "command":  "E:/数据结构实验/.tools/w64devkit/bin/gcc.exe",
                      "type":  "process",
                      "args":  [
                                   "-std=c11",
                                   "-Wall",
                                   "-Wextra",
                                   "-g",
                                   "-O0",
                                   "${file}",
                                   "-o",
                                   "${fileDirname}/${fileBasenameNoExtension}.exe"
                               ],
                      "options":  {
                                      "cwd":  "${fileDirname}"
                                  },
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  true
                                }
                  },
                  {
                      "label":  "C: check syntax",
                      "problemMatcher":  [
                                             "$gcc"
                                         ],
                      "command":  "E:/数据结构实验/.tools/w64devkit/bin/gcc.exe",
                      "type":  "process",
                      "args":  [
                                   "-std=c11",
                                   "-Wall",
                                   "-Wextra",
                                   "-fsyntax-only",
                                   "${file}"
                               ],
                      "options":  {
                                      "cwd":  "${fileDirname}"
                                  }
                  },
                  {
                      "problemMatcher":  [

                                         ],
                      "label":  "C: run active file",
                      "dependsOn":  "C: build active file",
                      "command":  "${fileDirname}/${fileBasenameNoExtension}.exe",
                      "type":  "process",
                      "presentation":  {
                                           "reveal":  "always",
                                           "panel":  "dedicated",
                                           "focus":  true
                                       },
                      "options":  {
                                      "cwd":  "${fileDirname}"
                                  }
                  }
              ]
}